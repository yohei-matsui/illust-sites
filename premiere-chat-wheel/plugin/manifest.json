{
  "id": "com.yoheimatsui.onepochi.wheel",
  "name": "ワンポチくん - ホイール -",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "manifestVersion": 5,
  "requiredPermissions": {
    "network": {
      "domains": "all"
    }
  },
  "entrypoints": [
    {
      "id": "onepochiWheel",
      "type": "panel",
      "label": { "default": "ワンポチくん - ホイール -" },
      "minimumSize": { "width": 320, "height": 420 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 360, "height": 640 },
      "preferredFloatingSize": { "width": 380, "height": 700 }
    }
  ]
}
